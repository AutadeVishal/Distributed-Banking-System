{
  "info": {
    "_postman_id": "7d6ed09a6-7c6d-4e5a-8f57-2a6f9e7f4d1a",
    "name": "Distributed Banking System",
    "description": "Requests for the account, transaction, and payment APIs. The collection uses the API gateway by default.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accountNumber",
      "value": "100000000001"
    },
    {
      "key": "receiverAccountNumber",
      "value": "100000000002"
    },
    {
      "key": "transactionId",
      "value": "1"
    },
    {
      "key": "otp",
      "value": "123456"
    },
    {
      "key": "idempotencyKey",
      "value": "{{$guid}}"
    }
  ],
  "item": [
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountHolderName\": \"Alice Johnson\",\n  \"email\": \"alice@example.com\",\n  \"phone\": \"9876543210\",\n  \"accountType\": \"SAVINGS\",\n  \"initialDeposit\": 10000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/account",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "account"
              ]
            }
          }
        },
        {
          "name": "Get account",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/account/{{accountNumber}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "account",
                "{{accountNumber}}"
              ]
            }
          }
        },
        {
          "name": "Get balance",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/account/{{accountNumber}}/balance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "account",
                "{{accountNumber}}",
                "balance"
              ]
            }
          }
        },
        {
          "name": "Lock account",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/v1/account/{{accountNumber}}/lock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "account",
                "{{accountNumber}}",
                "lock"
              ]
            }
          }
        },
        {
          "name": "Unlock account",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/v1/account/{{accountNumber}}/unlock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "account",
                "{{accountNumber}}",
                "unlock"
              ]
            }
          }
        },
        {
          "name": "Transfer balance directly",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/v1/account/transfer?senderAccountNumber={{accountNumber}}&receiverAccountNumber={{receiverAccountNumber}}&amount=100.00",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "account",
                "transfer"
              ],
              "query": [
                {
                  "key": "senderAccountNumber",
                  "value": "{{accountNumber}}"
                },
                {
                  "key": "receiverAccountNumber",
                  "value": "{{receiverAccountNumber}}"
                },
                {
                  "key": "amount",
                  "value": "100.00"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Initiate transfer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderAccountNumber\": \"{{accountNumber}}\",\n  \"receiverAccountNumber\": \"{{receiverAccountNumber}}\",\n  \"amount\": 100.00,\n  \"description\": \"Postman test transfer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transaction/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transaction",
                "transfer"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.transactionId !== undefined) {",
                  "    pm.collectionVariables.set('transactionId', String(response.transactionId));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get transaction",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transaction/{{transactionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transaction",
                "{{transactionId}}"
              ]
            }
          }
        },
        {
          "name": "Get transaction history",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transaction/account/history/{{accountNumber}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transaction",
                "account",
                "history",
                "{{accountNumber}}"
              ]
            }
          }
        },
        {
          "name": "Request new OTP",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transaction/{{transactionId}}/request-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transaction",
                "{{transactionId}}",
                "request-otp"
              ]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transaction/{{transactionId}}/verify-otp?otp={{otp}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transaction",
                "{{transactionId}}",
                "verify-otp"
              ],
              "query": [
                {
                  "key": "otp",
                  "value": "{{otp}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create payment order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{accountNumber}}\",\n  \"amount\": 250.00,\n  \"description\": \"Postman payment test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payment/create-order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payment",
                "create-order"
              ]
            }
          }
        },
        {
          "name": "Payment webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.captured\",\n  \"payload\": {}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payment/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payment",
                "webhook"
              ]
            }
          }
        }
      ]
    }
  ]
}
